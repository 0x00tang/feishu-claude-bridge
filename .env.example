# Lark 国际版自建应用凭证
# 开发者后台：https://open.larksuite.com/app → 应用 → Credentials
LARK_APP_ID=
LARK_APP_SECRET=

# API 域名（国际版默认，一般不用改）
LARK_DOMAIN=https://open.larksuite.com

# 国内飞书用户改用：
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_DOMAIN=https://open.feishu.cn

# Claude Code 可执行文件路径（默认从 PATH 查找 claude）
# CLAUDE_BIN=/Users/echo/.local/bin/claude

# 默认工作目录（Claude Code 在此目录下读写文件、执行命令）
CLAUDE_WORKDIR=/Users/echo/Desktop/WorkSpace

# 权限模式：default | acceptEdits | dontAsk | bypassPermissions
CLAUDE_PERMISSION_MODE=acceptEdits

# 单次任务最长等待秒数
CLAUDE_TIMEOUT_SEC=600

# 仅允许这些 open_id 使用（逗号分隔，留空表示不限制）
# ALLOWED_OPEN_IDS=ou_xxx,ou_yyy
